<Project>
  <Target Name="GoatDockSignBundle" BeforeTargets="GenerateSingleFileBundle" DependsOnTargets="PrepareForBundle"
          Condition="'$(GoatDockSigning)' == 'true' and '$(PublishSingleFile)' == 'true'">
    <Error Condition="'$(CodeSigningThumbprint)' == '' or '$(CodeSigningTool)' == '' or '$(CodeSigningTimestamp)' == ''" Text="Informe certificado, SignTool e timestamp." />
    <PropertyGroup><GoatDockSignedDir>$(IntermediateOutputPath)signed-bundle\</GoatDockSignedDir></PropertyGroup>
    <ItemGroup>
      <GoatDockToSign Include="@(FilesToBundle)" Condition="'%(FilesToBundle.Extension)' == '.dll' and ($([System.String]::Copy('%(FilesToBundle.Filename)').StartsWith('Goat')) or '%(FilesToBundle.Filename)' == 'GoatDockFinder-Setup' or '%(FilesToBundle.Filename)' == 'Ical.Net' or '%(FilesToBundle.Filename)' == 'NodaTime')" />
    </ItemGroup>
    <MakeDir Directories="$(GoatDockSignedDir)" />
    <Copy SourceFiles="@(GoatDockToSign)" DestinationFiles="@(GoatDockToSign->'$(GoatDockSignedDir)%(Filename)%(Extension)')" />
    <Exec Command="&quot;$(CodeSigningTool)&quot; sign /sha1 $(CodeSigningThumbprint) /s My /fd SHA256 /tr &quot;$(CodeSigningTimestamp)&quot; /td SHA256 &quot;$(GoatDockSignedDir)%(GoatDockToSign.Filename)%(GoatDockToSign.Extension)&quot;" Condition="'@(GoatDockToSign)' != ''" />
    <ItemGroup>
      <FilesToBundle Remove="@(GoatDockToSign)" />
      <FilesToBundle Include="@(GoatDockToSign->'$(GoatDockSignedDir)%(Filename)%(Extension)')"><RelativePath>%(GoatDockToSign.RelativePath)</RelativePath></FilesToBundle>
      <GoatDockVerify Include="@(FilesToBundle)" Condition="'%(FilesToBundle.Extension)' == '.dll'" />
    </ItemGroup>
    <Exec Command="&quot;$(CodeSigningTool)&quot; verify /pa &quot;%(GoatDockVerify.Identity)&quot;" Condition="'@(GoatDockVerify)' != ''" />
  </Target>
</Project>
