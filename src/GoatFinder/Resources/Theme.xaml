<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Valores padrão da barra; cada janela da barra os substitui conforme as configurações -->
    <FontFamily x:Key="Bar.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="Bar.FontSize">13</sys:Double>
    <sys:Double x:Key="Bar.ButtonHeight">22</sys:Double>
    <Thickness x:Key="Bar.Padding">9,0</Thickness>

    <!-- Barra de menu -->
    <SolidColorBrush x:Key="Bar.Fg"
            Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Bar.Hover"
            Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Bar.Pressed"
            Color="#55FFFFFF"/>

    <!-- Janelas do Finder -->
    <SolidColorBrush x:Key="Win.Bg"
            Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="Win.Toolbar"
            Color="#FF2A2A2D"/>
    <SolidColorBrush x:Key="Win.Sidebar"
            Color="#FF242427"/>
    <SolidColorBrush x:Key="Win.Border"
            Color="#FF3A3A40"/>
    <SolidColorBrush x:Key="Win.Fg"
            Color="#FFF2F2F7"/>
    <SolidColorBrush x:Key="Win.FgDim"
            Color="#FF9A9AA2"/>
    <SolidColorBrush x:Key="Win.Hover"
            Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Win.Selected"
            Color="#FF0A5CD6"/>
    <SolidColorBrush x:Key="Win.SelectedInactive"
            Color="#FF48484E"/>
    <SolidColorBrush x:Key="Accent"
            Color="#FF0A84FF"/>

    <!-- Menus -->
    <SolidColorBrush x:Key="Menu.Bg"
            Color="#F01E1E22"/>
    <SolidColorBrush x:Key="Menu.Border"
            Color="#FF45454C"/>
    <SolidColorBrush x:Key="Menu.Hover"
            Color="#FF0A5CD6"/>
    <SolidColorBrush x:Key="Menu.Fg"
            Color="#FFF2F2F7"/>
    <SolidColorBrush x:Key="Menu.FgDisabled"
            Color="#FF6E6E76"/>

    <Style x:Key="BarButton"
            TargetType="Button">
        <Setter Property="Foreground"
                Value="{DynamicResource Bar.Fg}"/>
        <Setter Property="FontFamily"
                Value="{DynamicResource Bar.FontFamily}"/>
        <Setter Property="FontSize"
                Value="{DynamicResource Bar.FontSize}"/>
        <Setter Property="Padding"
                Value="{DynamicResource Bar.Padding}"/>
        <Setter Property="Height"
                Value="{DynamicResource Bar.ButtonHeight}"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
        <Setter Property="Focusable"
                Value="False"/>
        <Setter Property="Cursor"
                Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource Bar.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed"
                                Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource Bar.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolButton"
            TargetType="Button">
        <Setter Property="Foreground"
                Value="{StaticResource Win.Fg}"/>
        <Setter Property="FontFamily"
                Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize"
                Value="15"/>
        <Setter Property="Width"
                Value="32"/>
        <Setter Property="Height"
                Value="28"/>
        <Setter Property="Margin"
                Value="1,0"/>
        <Setter Property="Focusable"
                Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource Win.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                Value="False">
                            <Setter Property="Opacity"
                                    Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolToggle"
            TargetType="ToggleButton">
        <Setter Property="Foreground"
                Value="{StaticResource Win.Fg}"/>
        <Setter Property="FontFamily"
                Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize"
                Value="15"/>
        <Setter Property="Width"
                Value="32"/>
        <Setter Property="Height"
                Value="28"/>
        <Setter Property="Margin"
                Value="1,0"/>
        <Setter Property="Focusable"
                Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource Win.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked"
                                Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource Win.SelectedInactive}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButton"
            TargetType="Button">
        <Setter Property="Foreground"
                Value="{StaticResource Win.FgDim}"/>
        <Setter Property="FontSize"
                Value="12"/>
        <Setter Property="Padding"
                Value="4,1"/>
        <Setter Property="Focusable"
                Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource Win.Hover}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource Win.Fg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkTextBox"
            TargetType="TextBox">
        <Setter Property="Background"
                Value="#FF353539"/>
        <Setter Property="Foreground"
                Value="{StaticResource Win.Fg}"/>
        <Setter Property="CaretBrush"
                Value="{StaticResource Win.Fg}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource Win.Border}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Padding"
                Value="8,4"/>
        <Setter Property="FontSize"
                Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ScrollViewer x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarItem"
            TargetType="ListBoxItem">
        <Setter Property="Foreground"
                Value="{StaticResource Win.Fg}"/>
        <Setter Property="Padding"
                Value="8,5"/>
        <Setter Property="Margin"
                Value="6,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource Win.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected"
                                Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource Win.SelectedInactive}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FileItem"
            TargetType="ListBoxItem">
        <Setter Property="Foreground"
                Value="{StaticResource Win.Fg}"/>
        <Setter Property="SnapsToDevicePixels"
                Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource Win.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected"
                                Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource Win.Selected}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus de contexto escuros -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background"
                Value="{StaticResource Menu.Bg}"/>
        <Setter Property="Foreground"
                Value="{StaticResource Menu.Fg}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource Menu.Border}"/>
        <Setter Property="HasDropShadow"
                Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="5"
                            MinWidth="220">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}"
            TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1"
                            Margin="8,4"
                            Background="{StaticResource Menu.Border}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground"
                Value="{StaticResource Menu.Fg}"/>
        <Setter Property="FontSize"
                Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="8,5"
                                MinHeight="26">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Check"
                                        Grid.Column="0"
                                        Text="&#xE73E;"
                                        FontFamily="{StaticResource IconFont}"
                                           FontSize="11"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1"
                                        ContentSource="Header"
                                        RecognizesAccessKey="False"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="Gesture"
                                        Grid.Column="2"
                                        Text="{TemplateBinding InputGestureText}"
                                        Margin="24,0,0,0"
                                           Foreground="#FF8E8E93"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="Arrow"
                                        Grid.Column="2"
                                        Text="&#xE76C;"
                                        FontFamily="{StaticResource IconFont}"
                                           FontSize="10"
                                        Margin="24,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                                Placement="Right"
                                HorizontalOffset="2"
                                VerticalOffset="-6"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Fade">
                            <Border Background="{StaticResource Menu.Bg}"
                                    BorderBrush="{StaticResource Menu.Border}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="5"
                                    MinWidth="200"
                                    Margin="0,0,10,10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14"
                                            ShadowDepth="3"
                                            Opacity="0.45"
                                            Color="Black"/>
                                </Border.Effect>
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems"
                                Value="True">
                            <Setter TargetName="Arrow"
                                    Property="Visibility"
                                    Value="Visible"/>
                            <Setter TargetName="Gesture"
                                    Property="Visibility"
                                    Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked"
                                Value="True">
                            <Setter TargetName="Check"
                                    Property="Visibility"
                                    Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted"
                                Value="True">
                            <Setter TargetName="Bd"
                                    Property="Background"
                                    Value="{StaticResource Menu.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                Value="False">
                            <Setter Property="Foreground"
                                    Value="{StaticResource Menu.FgDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background"
                Value="#FF2C2C30"/>
        <Setter Property="Foreground"
                Value="{StaticResource Win.Fg}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource Win.Border}"/>
    </Style>

</ResourceDictionary>
