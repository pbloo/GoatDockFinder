<Window x:Class="GoatFinder.Views.FinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GoatFinder.ViewModels"
        Title="{Binding Title}"
        Width="1080"
        Height="680"
        MinWidth="680"
        MinHeight="420"
        Background="{StaticResource Win.Bg}"
        Foreground="{StaticResource Win.Fg}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="C"
                Modifiers="Ctrl"
                Command="{Binding CopyCommand}"/>
        <KeyBinding Key="X"
                Modifiers="Ctrl"
                Command="{Binding CutCommand}"/>
        <KeyBinding Key="V"
                Modifiers="Ctrl"
                Command="{Binding PasteCommand}"/>
        <KeyBinding Key="D"
                Modifiers="Ctrl"
                Command="{Binding DuplicateCommand}"/>
        <KeyBinding Key="I"
                Modifiers="Ctrl"
                Command="{Binding InfoCommand}"/>
        <KeyBinding Key="F"
                Modifiers="Ctrl"
                Command="{Binding FocusSearchCommand}"/>
        <KeyBinding Key="N"
                Modifiers="Ctrl+Shift"
                Command="{Binding NewFolderCommand}"/>
        <KeyBinding Key="D1"
                Modifiers="Ctrl"
                Command="{Binding ShowListCommand}"/>
        <KeyBinding Key="D2"
                Modifiers="Ctrl"
                Command="{Binding ShowIconsCommand}"/>
        <KeyBinding Key="F5"
                Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Up"
                Modifiers="Ctrl"
                Command="{Binding UpCommand}"/>
        <KeyBinding Key="Left"
                Modifiers="Alt"
                Command="{Binding BackCommand}"/>
        <KeyBinding Key="Right"
                Modifiers="Alt"
                Command="{Binding ForwardCommand}"/>
        <KeyBinding Key="OemPeriod"
                Modifiers="Ctrl+Shift"
                Command="{Binding ToggleHiddenCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="FileItemBound"
                TargetType="ListBoxItem"
                BasedOn="{StaticResource FileItem}">
            <Setter Property="IsSelected"
                    Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Margin"
                    Value="0,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}"
                        Value="True">
                    <Setter Property="Opacity"
                            Value="0.6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCut}"
                        Value="True">
                    <Setter Property="Opacity"
                            Value="0.4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ListRowTemplate"
                DataType="{x:Type vm:FileItemViewModel}">
            <Grid Height="28"
                    ToolTip="{Binding FullPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0"
                        Margin="8,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}"
                            Width="20"
                            Height="20"
                            RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Column="1"
                            Text="{Binding Name}"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"/>
                </Grid>
                <TextBlock Grid.Column="1"
                        Text="{Binding ModifiedText}"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Win.FgDim}"/>
                <TextBlock Grid.Column="2"
                        Text="{Binding SizeText}"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Win.FgDim}"/>
                <TextBlock Grid.Column="3"
                        Text="{Binding Kind}"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Win.FgDim}"
                        TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="IconTileTemplate"
                DataType="{x:Type vm:FileItemViewModel}">
            <StackPanel Width="104"
                    Margin="4"
                    ToolTip="{Binding FullPath}">
                <Image Source="{Binding Visual}"
                        Width="64"
                        Height="64"
                        Stretch="Uniform"
                        RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Name}"
                        Margin="0,6,0,0"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                        MaxHeight="34"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SidebarTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}"
                        FontFamily="{StaticResource IconFont}"
                        Foreground="{StaticResource Accent}"
                           FontSize="15"
                        Width="22"
                        VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        MaxWidth="140"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de ferramentas -->
        <Border Grid.Row="0"
                Background="{StaticResource Win.Toolbar}"
                BorderBrush="{StaticResource Win.Border}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}"
                            Content="&#xE72B;"
                            Command="{Binding BackCommand}"
                            ToolTip="Voltar (Alt+←)"/>
                    <Button Style="{StaticResource ToolButton}"
                            Content="&#xE72A;"
                            Command="{Binding ForwardCommand}"
                            ToolTip="Avançar (Alt+→)"/>
                    <Button Style="{StaticResource ToolButton}"
                            Content="&#xE74A;"
                            Command="{Binding UpCommand}"
                            ToolTip="Pasta superior (Ctrl+↑)"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                        Text="{Binding Title}"
                        FontSize="15"
                        FontWeight="SemiBold"
                           VerticalAlignment="Center"
                        Margin="14,0,0,0"
                        MaxWidth="260"
                        TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="3"
                        Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}"
                            Content="&#xE8F4;"
                            Command="{Binding NewFolderCommand}"
                            ToolTip="Nova pasta (Ctrl+Shift+N)"/>
                    <Button Style="{StaticResource ToolButton}"
                            Content="&#xE756;"
                            Command="{Binding TerminalCommand}"
                            ToolTip="Abrir Terminal aqui"/>
                    <Rectangle Width="1"
                            Margin="6,4"
                            Fill="{StaticResource Win.Border}"/>
                    <ToggleButton Style="{StaticResource ToolToggle}"
                            Content="&#xE8FD;"
                            IsChecked="{Binding IsListView, Mode=TwoWay}"
                            ToolTip="como Lista (Ctrl+1)"/>
                    <ToggleButton Style="{StaticResource ToolToggle}"
                            Content="&#xE80A;"
                            IsChecked="{Binding IsIconView, Mode=TwoWay}"
                            ToolTip="como Ícones (Ctrl+2)"/>
                    <Button Style="{StaticResource ToolButton}"
                            Content="&#xE8CB;"
                            Click="OnSortClick"
                            ToolTip="Ordenar por"/>
                    <ToggleButton Style="{StaticResource ToolToggle}"
                            Content="&#xE7B3;"
                            IsChecked="{Binding ShowHidden, Mode=TwoWay}"
                            ToolTip="Mostrar itens ocultos (Ctrl+Shift+.)"/>
                    <ToggleButton Style="{StaticResource ToolToggle}"
                            Content="&#xE8A1;"
                            IsChecked="{Binding PreviewPaneVisible, Mode=TwoWay}"
                            ToolTip="Painel de visualização (Espaço)"/>
                </StackPanel>

                <TextBox x:Name="SearchBox"
                        Grid.Column="4"
                        Width="210"
                        Margin="10,0,0,0"
                        Style="{StaticResource DarkTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Buscar nesta pasta (Ctrl+F)"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Barra lateral -->
            <Border Grid.Column="0"
                    Background="{StaticResource Win.Sidebar}"
                    BorderBrush="{StaticResource Win.Border}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,10">
                        <TextBlock Text="Favoritos"
                                Foreground="{StaticResource Win.FgDim}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Margin="14,4,0,4"/>
                        <ListBox x:Name="FavoritesList"
                                ItemsSource="{Binding Favorites}"
                                Background="Transparent"
                                BorderThickness="0"
                                 ItemContainerStyle="{StaticResource SidebarItem}"
                                ItemTemplate="{StaticResource SidebarTemplate}"
                                 SelectionChanged="OnSidebarSelectionChanged"
                                AllowDrop="True"
                                Drop="OnSidebarDrop"
                                DragOver="OnSidebarDragOver"/>
                        <TextBlock Text="Locais"
                                Foreground="{StaticResource Win.FgDim}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Margin="14,14,0,4"/>
                        <ListBox x:Name="DrivesList"
                                ItemsSource="{Binding Drives}"
                                Background="Transparent"
                                BorderThickness="0"
                                 ItemContainerStyle="{StaticResource SidebarItem}"
                                ItemTemplate="{StaticResource SidebarTemplate}"
                                 SelectionChanged="OnSidebarSelectionChanged"
                                AllowDrop="True"
                                Drop="OnSidebarDrop"
                                DragOver="OnSidebarDragOver"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Lista de arquivos -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                        Margin="8,6,8,2"
                        Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource LinkButton}"
                            Content="{Binding HeaderName}"
                            Command="{Binding SortByCommand}"
                            CommandParameter="Name"
                            HorizontalAlignment="Left"
                            Margin="28,0,0,0"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource LinkButton}"
                            Content="{Binding HeaderModified}"
                            Command="{Binding SortByCommand}"
                            CommandParameter="Modified"
                            HorizontalAlignment="Left"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource LinkButton}"
                            Content="{Binding HeaderSize}"
                            Command="{Binding SortByCommand}"
                            CommandParameter="Size"
                            HorizontalAlignment="Left"/>
                    <Button Grid.Column="3"
                            Style="{StaticResource LinkButton}"
                            Content="{Binding HeaderKind}"
                            Command="{Binding SortByCommand}"
                            CommandParameter="Kind"
                            HorizontalAlignment="Left"/>
                </Grid>

                <ListBox x:Name="FilesList"
                        Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Extended"
                         Background="Transparent"
                        BorderThickness="0"
                        Margin="8,0,8,8"
                        AllowDrop="True"
                         ItemContainerStyle="{StaticResource FileItemBound}"
                        ItemTemplate="{StaticResource ListRowTemplate}"
                         Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                         KeyDown="OnListKeyDown"
                        MouseDoubleClick="OnListDoubleClick"
                         PreviewMouseLeftButtonDown="OnListMouseDown"
                        PreviewMouseMove="OnListMouseMove"
                         PreviewMouseRightButtonDown="OnListRightClick"
                        ContextMenuOpening="OnListContextMenu"
                         DragOver="OnListDragOver"
                        Drop="OnListDrop">
                    <ListBox.InputBindings>
                        <KeyBinding Key="A"
                                Modifiers="Ctrl"
                                Command="{Binding SelectAllCommand}"/>
                    </ListBox.InputBindings>
                </ListBox>

                <ListBox x:Name="IconsList"
                        Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        SelectionMode="Extended"
                         Background="Transparent"
                        BorderThickness="0"
                        Margin="8,0,8,8"
                        AllowDrop="True"
                         ItemContainerStyle="{StaticResource FileItemBound}"
                        ItemTemplate="{StaticResource IconTileTemplate}"
                         Visibility="{Binding IsIconView, Converter={StaticResource BoolToVisibility}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyDown="OnListKeyDown"
                        MouseDoubleClick="OnListDoubleClick"
                         PreviewMouseLeftButtonDown="OnListMouseDown"
                        PreviewMouseMove="OnListMouseMove"
                         PreviewMouseRightButtonDown="OnListRightClick"
                        ContextMenuOpening="OnListContextMenu"
                         DragOver="OnListDragOver"
                        Drop="OnListDrop">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.InputBindings>
                        <KeyBinding Key="A"
                                Modifiers="Ctrl"
                                Command="{Binding SelectAllCommand}"/>
                    </ListBox.InputBindings>
                </ListBox>

                <TextBlock Grid.Row="1"
                        Text="{Binding EmptyMessage}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                           Foreground="{StaticResource Win.FgDim}"
                        FontSize="15"
                        IsHitTestVisible="False"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <!-- Painel de visualização -->
            <Border Grid.Column="2"
                    Width="260"
                    Background="{StaticResource Win.Sidebar}"
                    BorderBrush="{StaticResource Win.Border}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding PreviewPaneVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <Image Source="{Binding PreviewImage}"
                                MaxHeight="220"
                                Stretch="Uniform"
                                RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center"
                                Margin="0,0,0,12"/>
                        <Image Source="{Binding PreviewIcon}"
                                Width="72"
                                Height="72"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewImage}"
                                                Value="{x:Null}">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding PreviewTitle}"
                                FontSize="15"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                TextAlignment="Center"/>
                        <TextBlock Text="{Binding PreviewDetails}"
                                Margin="0,8,0,0"
                                Foreground="{StaticResource Win.FgDim}"
                                TextWrapping="Wrap"
                                TextAlignment="Center"/>
                        <TextBlock Text="{Binding PreviewText}"
                                Margin="0,14,0,0"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="11"
                                   Foreground="{StaticResource Win.FgDim}"
                                TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Caminho e status -->
        <Border Grid.Row="2"
                Background="{StaticResource Win.Toolbar}"
                BorderBrush="{StaticResource Win.Border}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                        Text="{Binding StatusText}"
                        Foreground="{StaticResource Win.FgDim}"
                        FontSize="12"
                        VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding Breadcrumb}"
                        Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BreadcrumbItem}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="›"
                                        Foreground="{StaticResource Win.FgDim}"
                                        VerticalAlignment="Center"
                                           Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Style="{StaticResource LinkButton}"
                                        Content="{Binding Name}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding FullPath}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</Window>
