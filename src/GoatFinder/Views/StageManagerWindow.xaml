<Window x:Class="GoatFinder.Views.StageManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GoatFinder.Controls"
        Title="Stage Manager"
        Width="196"
        Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False">
    <Window.Resources>
        <Style x:Key="StageTileButton"
                TargetType="Button">
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Margin"
                    Value="0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Presenter"
                                RenderTransformOrigin="0,0.5">
                            <ContentPresenter.RenderTransform>
                                <ScaleTransform x:Name="Scale"
                                        ScaleX="1"
                                        ScaleY="1"/>
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                    Storyboard.TargetProperty="ScaleX"
                                                    To="1.06"
                                                    Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    To="1.06"
                                                    Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                    Storyboard.TargetProperty="ScaleX"
                                                    To="1"
                                                    Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    To="1"
                                                    Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
            Background="{x:Null}"
            Focusable="False">
        <ItemsControl ItemsSource="{Binding Items}"
                VerticalAlignment="Center"
                Margin="4,0,0,0"
                Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource StageTileButton}"
                            Click="OnItemClick"
                            ToolTip="{Binding Title}"
                            Cursor="Hand">
                        <!-- Background transparente: sem ele, so os pixels do icone recebiam o clique -->
                        <Grid Width="164"
                                Height="116"
                                Background="Transparent"
                                RenderTransformOrigin="0,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="Slide"
                                        X="-48"/>
                            </Grid.RenderTransform>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Slide"
                                                    Storyboard.TargetProperty="X"
                                                    To="0"
                                                    Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>

                            <Border CornerRadius="12"
                                    Background="#40101014"
                                    BorderBrush="#30FFFFFF"
                                    BorderThickness="1"
                                    Margin="4,6,10,6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16"
                                            ShadowDepth="2"
                                            Opacity="0.45"/>
                                </Border.Effect>
                            </Border>
                            <controls:TiltedThumbnail Source="{Binding Thumbnail}"
                                    Margin="8,10,14,10"/>
                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Width="34"
                                    Height="34"
                                    CornerRadius="17"
                                    Background="#CC1C1C1E"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1"
                                    Margin="0,0,0,0">
                                <Image Source="{Binding Icon}"
                                        Width="22"
                                        Height="22"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Window>
