<UserControl xmlns:atividade="clr-namespace:GoatDock.Common" atividade:AtividadeVisual.Componente="Spotify" x:Class="GoatDock.Views.Sections.SectionSpotifyInline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GoatDock.Converters"
             Margin="{Binding DataContext.MargemItem, RelativeSource={RelativeSource AncestorType=Window}}">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvertBoolToVis"/>
        <Style x:Key="SpotifyBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="14" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="12" Padding="8,6" Background="#1C1C22" BorderBrush="#2C2C36" BorderThickness="1"
            Visibility="{Binding Spotify.Habilitado, Converter={StaticResource BoolToVis}}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Capa (ou o logotipo do Spotify quando não há capa) -->
                <Border Width="40" Height="40" CornerRadius="8" Background="#121217" Cursor="Hand" ToolTip="Abrir o Spotify" Margin="0,0,8,0">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding Spotify.AbrirSpotifyCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Image Source="{Binding Spotify.Capa}" Stretch="UniformToFill">
                            <Image.Clip><RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,40,40"/></Image.Clip>
                        </Image>
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8D6;" FontSize="18" Foreground="#1DB954"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Spotify.TemCapa, Converter={StaticResource InvertBoolToVis}}"/>
                    </Grid>
                </Border>

                <StackPanel Width="140" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Text="{Binding Spotify.Titulo}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Spotify.Artista}" FontSize="11" Foreground="#A9B8C9" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Style="{StaticResource SpotifyBtn}" Command="{Binding Spotify.AleatorioCommand}" ToolTip="Aleatório" AutomationProperties.Name="Aleatório">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B1;" FontSize="13" Foreground="{Binding Spotify.CorAleatorio}"/>
                </Button>
                <Button Style="{StaticResource SpotifyBtn}" Command="{Binding Spotify.AnteriorCommand}" ToolTip="Faixa anterior" AutomationProperties.Name="Faixa anterior">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE100;" FontSize="14" Foreground="#FFFFFF"/>
                </Button>
                <Button Style="{StaticResource SpotifyBtn}" Command="{Binding Spotify.PlayPauseCommand}" ToolTip="Tocar ou pausar" AutomationProperties.Name="Tocar ou pausar" Background="#1DB954">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Spotify.GlifoPlay}" FontSize="14" Foreground="#000000"/>
                </Button>
                <Button Style="{StaticResource SpotifyBtn}" Command="{Binding Spotify.ProximoCommand}" ToolTip="Próxima faixa" AutomationProperties.Name="Próxima faixa">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE101;" FontSize="14" Foreground="#FFFFFF"/>
                </Button>
                <Button Style="{StaticResource SpotifyBtn}" Command="{Binding Spotify.RepeticaoCommand}" ToolTip="Repetir" AutomationProperties.Name="Repetir">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Spotify.GlifoRepeticao}" FontSize="13" Foreground="{Binding Spotify.CorRepeticao}"/>
                </Button>
            </StackPanel>

            <!-- Barra de progresso: clique para ir a outro ponto da faixa -->
            <Border x:Name="BarraProgresso" Height="12" Background="Transparent" Cursor="Hand" Margin="0,4,0,0"
                    MouseLeftButtonUp="OnProgressoClick" ToolTip="Ir para este ponto da faixa">
                <ProgressBar Height="3" Minimum="0" Maximum="1" Value="{Binding Spotify.Progresso, Mode=OneWay}"
                             Foreground="#1DB954" Background="#42463E" BorderThickness="0" IsHitTestVisible="False"
                             AutomationProperties.Name="Progresso da música"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
